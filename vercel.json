{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/cocina",
      "destination": "/cocina.html"
    },
    {
      "source": "/menu",
      "destination": "/index.html"
    }
  ]
}
