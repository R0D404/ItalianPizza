{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/vistas/admin/index.html"
    },
    {
      "source": "/cocina",
      "destination": "/vistas/cocina/index.html"
    },
    {
      "source": "/menu",
      "destination": "/vistas/cliente/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
